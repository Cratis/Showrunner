<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CratisEnvironmentsVersion>3.114.0</CratisEnvironmentsVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cratis — keep the public Cratis / Arc family aligned so generated proxies and runtime
         contracts are built against the same Chronicle contract generation. Cratis.Arc.Chronicle
         22.185.1 requires Cratis.Chronicle >= 19.144.0 and Cratis.Fundamentals >= 7.34.0. -->
    <PackageVersion Include="Cratis.Arc" Version="22.185.1" />
    <PackageVersion Include="Cratis.Arc.Chronicle" Version="22.185.1" />
    <PackageVersion Include="Cratis.Arc.ProxyGenerator.Build" Version="22.185.1" />
    <PackageVersion Include="Cratis.Arc.Chronicle.Testing" Version="22.185.1" />
    <PackageVersion Include="Cratis.Fundamentals" Version="7.34.0" />
    <!-- Keep Chronicle clients and testing support on the same release. -->
    <PackageVersion Include="Cratis.Metrics.Roslyn" Version="7.34.0" />
    <!-- Cratis.Chronicle.Testing does not declare Cratis.Orleans or Cratis.Orleans.Storage.MongoDB, which the inline specifications (Debug only) load at run time. -->
    <GlobalPackageReference Include="Cratis.Orleans" Version="1.27.2" Condition="'$(Configuration)' == 'Debug'" />
    <GlobalPackageReference Include="Cratis.Orleans.Storage.MongoDB" Version="1.27.2" Condition="'$(Configuration)' == 'Debug'" />
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
    <PackageVersion Include="Cratis.Chronicle" Version="19.155.0" />
    <PackageVersion Include="Cratis.Chronicle.Testing" Version="19.155.0" />
    <!-- Serves the integration specifications' web host in memory. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <!-- Verifies the RS256 tokens AuthProxy signs its on-behalf calls with; the same library AuthProxy signs them with. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Referenced directly (Debug-only, see Source/DotNET/Directory.Build.props) so the version lands in
         the test output directory: Cratis's generated type-discovery provider loads
         Microsoft.CodeAnalysis.CSharp at runtime, and without a direct reference it is absent from
         bin/Debug, which throws FileNotFoundException the moment a CommandScenario spec runs. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <!-- Herald (email). MailKit sends over SMTP and writes the .eml files of the development transport; it is the
         maintained SMTP client for .NET (System.Net.Mail's SmtpClient is documented as not recommended). Handlebars.Net
         renders the templates in strict mode. PreMailer.Net moves the template's <style> rules into style attributes,
         which email clients need; it is MIT licensed and actively released. -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Handlebars.Net" Version="2.4.3" />
    <PackageVersion Include="PreMailer.Net" Version="2.7.4" />
    <!-- Integration specifications only: an SMTP server running inside the test process. -->
    <PackageVersion Include="SmtpServer" Version="11.1.0" />
    <!-- Stage Manager (Kubernetes operator). KubeOps generates the custom resource definitions, and the RBAC the
         chart installs, from the C# types at build time. -->
    <PackageVersion Include="KubeOps.Operator" Version="13.3.5" />
    <PackageVersion Include="KubeOps.Generator" Version="13.3.5" />
    <!-- Cratis.Environments is not on NuGet yet. CratisEnvironmentsVersion is the one place to set the version;
         0.0.0-local is a build packed from Cratis/cli (branch env-onboarding/environments-secrets) into a local
         feed. Set it to the released version before this merges. -->
    <PackageVersion Include="Cratis.Environments" Version="$(CratisEnvironmentsVersion)" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" NoWarn="NU5104" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.253" />
    <!-- Testing & Specifications -->
    <PackageVersion Include="Cratis.Specifications.XUnit" Version="4.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <!-- Integration specifications only (Integration/): a real Chronicle kernel in a container. -->
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <!-- Testcontainers brings in SSH.NET 2025.1.0 (GHSA-q939-rpr3-3284); pull it forward to the patched release. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
