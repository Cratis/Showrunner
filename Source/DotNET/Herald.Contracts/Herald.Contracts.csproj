<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Must match PackageId below. Cratis.Types' project-reference discovery (used to find
             [EventType] records for Chronicle) resolves a referenced project by the library name
             recorded in deps.json, which is the PackageId for a packable project - a mismatched
             AssemblyName makes that resolution fail and silently drops every type in this assembly
             from discovery, both at runtime and in specs. -->
        <AssemblyName>Cratis.Showrunner.Herald.Contracts</AssemblyName>
        <RootNamespace>Cratis.Showrunner.Herald.Contracts</RootNamespace>
        <PackageId>Cratis.Showrunner.Herald.Contracts</PackageId>
        <Description>The event contracts for Herald — the Showrunner email part: the facts recorded when an email was sent, failed or bounced.</Description>
        <PackageTags>cratis;showrunner;herald;email;event-sourcing;chronicle</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Chronicle" />
    </ItemGroup>
</Project>
