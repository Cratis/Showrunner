<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Cratis.Showrunner.Notes</AssemblyName>
        <RootNamespace>Cratis.Showrunner.Notes</RootNamespace>
        <PackageId>Cratis.Showrunner.Notes</PackageId>
        <Description>Notes — the Showrunner product feedback part for applications: give, list and withdraw notes about what the user sees, and publish them to the people building the application, built on Cratis Arc and Chronicle.</Description>
        <PackageTags>cratis;showrunner;notes;feedback;arc;chronicle;event-sourcing</PackageTags>

        <!-- The TypeScript proxies for Notes' commands and queries are generated into the
             @cratis/showrunner.notes npm package. The Cratis.Showrunner.Notes namespace segments are
             skipped so a slice in Cratis.Showrunner.Notes.<Feature>.<Slice> lands in <Feature>/<Slice>/.
             Release builds clear CratisProxiesOutputPath (-p:CratisProxiesOutputPath=) so generation only
             runs from the Debug build. -->
        <CratisProxiesOutputPath>$(MSBuildThisFileDirectory)../../JavaScript/Notes</CratisProxiesOutputPath>
        <CratisProxiesSegmentsToSkip>3</CratisProxiesSegmentsToSkip>
        <CratisProxiesSkipOutputDeletion>true</CratisProxiesSkipOutputDeletion>
        <CratisProxiesSkipCommandNameInRoute>true</CratisProxiesSkipCommandNameInRoute>
        <CratisProxiesUseSourceFileAsOutputFile>true</CratisProxiesUseSourceFileAsOutputFile>

        <!-- Read models a command's validator takes as parameters are read fresh from the event log and guard the
             append: only the giver withdraws a note, once, also under concurrent requests. -->
        <CratisReadProtection>On</CratisReadProtection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Arc" />
        <PackageReference Include="Cratis.Arc.Chronicle" />
        <PackageReference Include="Cratis.Arc.ProxyGenerator.Build">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Notes.Contracts/Notes.Contracts.csproj" />
    </ItemGroup>
</Project>
