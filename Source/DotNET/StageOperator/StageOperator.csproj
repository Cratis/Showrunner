<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>Cratis.Showrunner.StageOperator</AssemblyName>
        <RootNamespace>Cratis.Showrunner.StageOperator</RootNamespace>
        <PackageId>Cratis.Showrunner.StageOperator</PackageId>
        <Description>The Stage operator — a Kubernetes operator that runs published Stage application versions permanently or for a period.</Description>
        <PackageTags>cratis;showrunner;stage;kubernetes;operator</PackageTags>

        <!-- The operator ships as the ghcr.io/cratis/showrunner-stage-operator image, not as a NuGet package. -->
        <IsPackable>false</IsPackable>
        <!-- Logging here is low frequency (reconcile decisions, not per request): plain templates over source-generated messages. Primary constructors are a style the repository does not adopt. -->
        <NoWarn>$(NoWarn);CA1848;CA1873;IDE0290</NoWarn>
        <!-- The operator has its own entry point; the test SDK must not generate one next to it in Debug. -->
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KubernetesClient" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
