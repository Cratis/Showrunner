<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Must match PackageId below. Cratis.Types' project-reference discovery (used to find
             [EventType] records for Chronicle) resolves a referenced project by the library name
             recorded in deps.json, which is the PackageId for a packable project - a mismatched
             AssemblyName makes that resolution fail and silently drops every type in this assembly
             from discovery, both at runtime and in specs. -->
        <AssemblyName>Cratis.Showrunner.Understudy.Contracts</AssemblyName>
        <RootNamespace>Cratis.Showrunner.Understudy.Contracts</RootNamespace>
        <PackageId>Cratis.Showrunner.Understudy.Contracts</PackageId>
        <Description>The public event contracts of the Showrunner Understudy: the facts published when a backup was taken or failed, a restore completed or failed, a rehearsal passed or failed, or a backup was downloaded.</Description>
        <PackageTags>cratis;showrunner;understudy;backup;restore;event-sourcing;chronicle</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Chronicle" />
    </ItemGroup>
</Project>
