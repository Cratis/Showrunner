{
    "type": "module",
    "name": "@cratis/showrunner.playbill.react",
    "version": "1.0.0",
    "description": "The Playbill release-notes experience for React — a releases page, a what is new dialog and an unread badge, drawn with Cratis Components, styled with the Cratis tokens and open to your own components, built on Cratis Arc.",
    "keywords": [
        "cratis",
        "showrunner",
        "playbill",
        "release-notes",
        "changelog",
        "whats-new",
        "arc",
        "react",
        "components"
    ],
    "homepage": "https://github.com/Cratis/Showrunner",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Showrunner.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "styles.css",
        "**/*.ts",
        "**/*.tsx",
        "!**/for_*/**",
        "!**/given/**",
        "!Examples/**",
        "!**/*.tsbuildinfo"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./styles": "./styles.css"
    },
    "scripts": {
        "prepare": "yarn g:build",
        "clean": "yarn g:clean",
        "compile": "yarn g:compile",
        "build": "yarn g:build",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "test:watch": "yarn g:test:watch",
        "ci": "yarn g:ci",
        "up": "yarn g:up"
    },
    "dependencies": {
        "@cratis/showrunner.playbill": "1.0.0",
        "react-markdown": "10.1.0"
    },
    "devDependencies": {
        "@cratis/arc": "24.8.0",
        "@cratis/arc.react": "24.8.0",
        "@cratis/components": "4.38.0",
        "@cratis/fundamentals": "7.34.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "reflect-metadata": "0.2.2"
    },
    "peerDependencies": {
        "@cratis/arc": "^24.0.0",
        "@cratis/arc.react": "^24.0.0",
        "@cratis/components": "^4.38.0",
        "@cratis/fundamentals": "^7.34.4",
        "react": "^19.0.0"
    },
    "sideEffects": [
        "*.css"
    ]
}
